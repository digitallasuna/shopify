[
  {
    "name": "theme_info",
    "theme_name": "Wakhan Styles",
    "theme_version": "1.0.0",
    "theme_author": "Wakhan Styles",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "Brand Identity",
    "settings": [
      {
        "type": "text",
        "id": "brand_name",
        "label": "Brand name",
        "default": "Wakhan Styles"
      },
      {
        "type": "image_picker",
        "id": "brand_logo",
        "label": "Brand logo"
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "header",
        "content": "Palette"
      },
      {
        "type": "color",
        "id": "color_primary",
        "default": "#111111",
        "label": "Primary (Charcoal Black)"
      },
      {
        "type": "color",
        "id": "color_background",
        "default": "#F8F6F2",
        "label": "Background (Warm Ivory)"
      },
      {
        "type": "color",
        "id": "color_surface",
        "default": "#EFECE6",
        "label": "Surface & Cards (Soft Beige)"
      },
      {
        "type": "color",
        "id": "color_accent",
        "default": "#6F1D2A",
        "label": "Accent (Burgundy)"
      },
      {
        "type": "color",
        "id": "color_text",
        "default": "#171717",
        "label": "Primary Text"
      },
      {
        "type": "color",
        "id": "color_text_muted",
        "default": "#6B6B6B",
        "label": "Muted Text"
      },
      {
        "type": "color",
        "id": "color_border",
        "default": "#D9D5CE",
        "label": "Borders & Dividers"
      },
      {
        "type": "color",
        "id": "color_white",
        "default": "#FFFFFF",
        "label": "Pure White"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "header",
        "content": "Headings (Editorial Serif)"
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "default": "garamond_n4",
        "label": "Heading Font"
      },
      {
        "type": "range",
        "id": "heading_scale",
        "min": 85,
        "max": 130,
        "step": 5,
        "unit": "%",
        "label": "Heading Size Scale",
        "default": 100
      },
      {
        "type": "header",
        "content": "Body & UI (Clean Sans-Serif)"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "work_sans_n4",
        "label": "Body & UI Font"
      },
      {
        "type": "range",
        "id": "body_scale",
        "min": 90,
        "max": 120,
        "step": 5,
        "unit": "%",
        "label": "Body Size Scale",
        "default": 100
      }
    ]
  },
  {
    "name": "Layout & Spacing",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "Max Page Width",
        "options": [
          {
            "value": "80rem",
            "label": "Compact (80rem)"
          },
          {
            "value": "90rem",
            "label": "Standard (90rem)"
          },
          {
            "value": "100rem",
            "label": "Wide Editorial (100rem)"
          },
          {
            "value": "115rem",
            "label": "Full Editorial (115rem)"
          }
        ],
        "default": "100rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 12,
        "max": 48,
        "step": 2,
        "unit": "px",
        "label": "Page Horizontal Margin",
        "default": 24
      },
      {
        "type": "range",
        "id": "section_spacing_desktop",
        "min": 40,
        "max": 120,
        "step": 4,
        "unit": "px",
        "label": "Section Spacing (Desktop)",
        "default": 80
      },
      {
        "type": "range",
        "id": "section_spacing_mobile",
        "min": 24,
        "max": 64,
        "step": 4,
        "unit": "px",
        "label": "Section Spacing (Mobile)",
        "default": 48
      },
      {
        "type": "range",
        "id": "grid_gap_desktop",
        "min": 12,
        "max": 40,
        "step": 2,
        "unit": "px",
        "label": "Grid Spacing (Desktop)",
        "default": 24
      },
      {
        "type": "range",
        "id": "grid_gap_mobile",
        "min": 8,
        "max": 24,
        "step": 2,
        "unit": "px",
        "label": "Grid Spacing (Mobile)",
        "default": 16
      }
    ]
  },
  {
    "name": "Buttons & Form Elements",
    "settings": [
      {
        "type": "range",
        "id": "button_corner_radius",
        "min": 0,
        "max": 8,
        "step": 1,
        "unit": "px",
        "label": "Button Corner Radius",
        "default": 0
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 8,
        "step": 1,
        "unit": "px",
        "label": "Input Corner Radius",
        "default": 2
      }
    ]
  }
]