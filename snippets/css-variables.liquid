{% style %}
  {% # Loads font variations with display: swap %}
  {{ settings.type_primary_font | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'weight', 'bold' | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}

  {% if settings.type_heading_font %}
    {{ settings.type_heading_font | font_face: font_display: 'swap' }}
    {{ settings.type_heading_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
    {{ settings.type_heading_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
  {% endif %}

  :root {
    /* --------------------------------------------------
       TYPOGRAPHY TOKENS
       -------------------------------------------------- */
    --font-primary--family: {{ settings.type_primary_font.family }}, {{ settings.type_primary_font.fallback_families }};
    --font-primary--style: {{ settings.type_primary_font.style }};
    --font-primary--weight: {{ settings.type_primary_font.weight }};

    {% if settings.type_heading_font %}
      --font-heading--family: {{ settings.type_heading_font.family }}, {{ settings.type_heading_font.fallback_families }};
      --font-heading--style: {{ settings.type_heading_font.style }};
      --font-heading--weight: {{ settings.type_heading_font.weight }};
    {% else %}
      --font-heading--family: "Garamond", "Baskerville", "Caslon", "Playfair Display", Georgia, serif;
      --font-heading--style: normal;
      --font-heading--weight: 400;
    {% endif %}

    --font-heading-scale: {{ settings.heading_scale | default: 100 | divided_by: 100.0 }};
    --font-body-scale: {{ settings.body_scale | default: 100 | divided_by: 100.0 }};

    /* --------------------------------------------------
       COLOR SYSTEM (CONTEMPORARY EDITORIAL PALETTE)
       -------------------------------------------------- */
    --color-primary: {{ settings.color_primary | default: '#111111' }};
    --color-background: {{ settings.color_background | default: '#F8F6F2' }};
    --color-surface: {{ settings.color_surface | default: '#EFECE6' }};
    --color-accent: {{ settings.color_accent | default: '#6F1D2A' }};
    --color-text: {{ settings.color_text | default: '#171717' }};
    --color-text-muted: {{ settings.color_text_muted | default: '#6B6B6B' }};
    --color-border: {{ settings.color_border | default: '#D9D5CE' }};
    --color-white: {{ settings.color_white | default: '#FFFFFF' }};

    /* Backward compatibility aliases */
    --color-foreground: var(--color-text);

    /* --------------------------------------------------
       LAYOUT & SPACING TOKENS
       -------------------------------------------------- */
    --page-width: {{ settings.max_page_width | default: '100rem' }};
    --page-margin: {{ settings.min_page_margin | default: 24 }}px;
    --section-spacing-desktop: {{ settings.section_spacing_desktop | default: 80 }}px;
    --section-spacing-mobile: {{ settings.section_spacing_mobile | default: 48 }}px;
    --grid-gap-desktop: {{ settings.grid_gap_desktop | default: 24 }}px;
    --grid-gap-mobile: {{ settings.grid_gap_mobile | default: 16 }}px;

    /* --------------------------------------------------
       SURFACE, RADIUS & SHADOW TOKENS
       -------------------------------------------------- */
    --button-radius: {{ settings.button_corner_radius | default: 0 }}px;
    --input-radius: {{ settings.input_corner_radius | default: 2 }}px;
    --style-border-radius-inputs: var(--input-radius);
    --card-radius: 0px;

    /* --------------------------------------------------
       MOTION TOKENS
       -------------------------------------------------- */
    --transition-fast: 150ms cubic-bezier(0.25, 0.46, 0.45, 0.94);
    --transition-normal: 250ms cubic-bezier(0.16, 1, 0.3, 1);
    --transition-slow: 400ms cubic-bezier(0.16, 1, 0.3, 1);
    --transition-editorial: 500ms cubic-bezier(0.16, 1, 0.3, 1);
  }
{% endstyle %}
