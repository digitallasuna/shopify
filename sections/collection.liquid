{% comment %}
  Wakhan Styles - Collection Template Section
  Renders collection header, responsive product grid using snippets/product-card.liquid,
  empty state handling, and accessible pagination.
{% endcomment %}

<div class="collection-page page-container section-spacing--medium">
  <!-- Collection Header -->
  <header class="collection-header text-center">
    <h1 class="collection-header__title font-heading text-h1">
      {{ collection.title }}
    </h1>
    {%- if collection.description != blank -%}
      <div class="collection-header__description text-lead rte">
        {{ collection.description }}
      </div>
    {%- endif -%}
  </header>

  <!-- Collection Products -->
  {%- paginate collection.products by 24 -%}
    {%- if collection.products.size == 0 -%}
      <div class="collection-empty text-center">
        <p class="collection-empty__message text-lead text-muted">
          No products found in this collection.
        </p>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary">
          Explore All Products
        </a>
      </div>
    {%- else -%}
      <div class="collection-products grid--products">
        {%- for product in collection.products -%}
          {% render 'product-card', product: product, media_aspect_ratio: 'portrait' %}
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <nav class="pagination-wrapper" aria-label="Pagination">
          {{ paginate | default_pagination }}
        </nav>
      {%- endif -%}
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% stylesheet %}
  .collection-header {
    margin-bottom: var(--space-8, 3rem);
    max-width: 800px;
    margin-inline: auto;
  }

  .collection-header__title {
    margin-bottom: var(--space-3, 0.75rem);
  }

  .collection-header__description {
    color: var(--color-text-muted);
  }

  .collection-empty {
    padding: var(--space-12, 4.5rem) 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4, 1rem);
  }

  .collection-products {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-6, 1.5rem);
  }

  .pagination-wrapper {
    margin-top: var(--space-10, 3.5rem);
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .pagination-wrapper .page,
  .pagination-wrapper .prev,
  .pagination-wrapper .next,
  .pagination-wrapper .current {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.5rem;
    height: 2.5rem;
    padding: 0 0.75rem;
    margin: 0 0.25rem;
    font-size: 0.875rem;
    border: 1px solid var(--color-border);
    color: var(--color-text-primary);
    text-decoration: none;
    transition: var(--transition-base);
  }

  .pagination-wrapper .current {
    background-color: var(--color-primary);
    color: var(--color-white);
    border-color: var(--color-primary);
  }

  .pagination-wrapper a:hover {
    border-color: var(--color-primary);
  }

  @media (max-width: 1024px) {
    .collection-products {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-4, 1rem);
    }
  }

  @media (max-width: 768px) {
    .collection-products {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-3, 0.75rem);
    }
  }

  @media (max-width: 480px) {
    .collection-products {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.5rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection Page",
  "settings": [],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
