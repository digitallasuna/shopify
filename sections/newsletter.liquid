{% comment %}
  Meticulous Fashion - Newsletter Section
  Integrated with native Shopify customer form ('customer'), tags subscribers as 'newsletter',
  handles success and error states, and maintains accessible input/button targets.
{% endcomment %}

{%- liquid
  assign bg_class = 'bg-soft-beige'
  if section.settings.bg_color == 'warm_ivory'
    assign bg_class = 'bg-warm-ivory'
  elsif section.settings.bg_color == 'dark'
    assign bg_class = 'bg-dark'
  endif

  assign form_id = 'NewsletterForm-' | append: section.id
-%}

<section
  id="Newsletter-{{ section.id }}"
  class="newsletter {{ bg_class }}{% if section.settings.full_width %} full-width{% endif %} section-spacing--{{ section.settings.section_spacing | default: 'medium' }}"
  role="region"
  aria-label="{{ section.settings.heading | default: 'Newsletter Subscription' | escape }}"
>
  <div class="page-container">
    <div class="newsletter__box">
      {%- if section.settings.eyebrow != blank -%}
        <span class="newsletter__eyebrow text-eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="newsletter__heading text-h2 font-heading">
          {{ section.settings.heading }}
        </h2>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <p class="newsletter__description text-lead">
          {{ section.settings.description }}
        </p>
      {%- endif -%}

      <!-- Native Shopify Customer Newsletter Form -->
      {% form 'customer', id: form_id, class: 'newsletter__form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">

        {%- if form.posted_successfully? -%}
          <div class="newsletter__feedback newsletter__feedback--success" role="status" tabindex="-1" autofocus>
            <p class="text-body">Thank you for subscribing to The Edit. Your seasonal previews will arrive shortly.</p>
          </div>
        {%- else -%}
          <div class="newsletter__input-group">
            <label for="NewsletterEmail-{{ section.id }}" class="visually-hidden">Email address</label>
            <input
              id="NewsletterEmail-{{ section.id }}"
              type="email"
              name="contact[email]"
              value="{{ form.email }}"
              class="form-input newsletter__input"
              placeholder="Enter your email address"
              aria-required="true"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="email"
              {% if form.errors %}
                aria-invalid="true"
                aria-describedby="NewsletterError-{{ section.id }}"
              {% endif %}
              required
            >
            <button
              type="submit"
              class="btn {% if section.settings.bg_color == 'dark' %}btn--secondary{% else %}btn--primary{% endif %} newsletter__submit"
              name="commit"
              aria-label="{{ section.settings.button_text | default: 'Subscribe' }}"
            >
              {{ section.settings.button_text | default: 'SUBSCRIBE' }}
            </button>
          </div>

          {%- if form.errors -%}
            <div id="NewsletterError-{{ section.id }}" class="newsletter__feedback newsletter__feedback--error" role="alert">
              <span class="text-small">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</span>
            </div>
          {%- endif -%}

          {%- if section.settings.privacy_note != blank -%}
            <p class="newsletter__privacy text-small">
              {{ section.settings.privacy_note }}
            </p>
          {%- endif -%}
        {%- endif -%}
      {% endform %}
    </div>
  </div>
</section>

{% stylesheet %}
  .newsletter {
    width: 100%;
    position: relative;
  }

  .newsletter__box {
    max-width: 620px;
    margin-inline: auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .newsletter__eyebrow {
    margin-bottom: 0.5rem;
  }

  .newsletter__heading {
    margin-bottom: 0.875rem;
    line-height: 1.15;
  }

  .newsletter__description {
    margin-bottom: 2rem;
  }

  .newsletter__form {
    width: 100%;
  }

  .newsletter__input-group {
    display: flex;
    gap: 0.5rem;
    width: 100%;
    align-items: stretch;
  }

  .newsletter__input {
    flex: 1 1 auto;
    min-height: 48px;
    background-color: var(--color-white);
  }

  .newsletter__submit {
    flex-shrink: 0;
    min-width: 150px;
    min-height: 48px;
  }

  .newsletter__privacy {
    margin-top: 1rem;
    color: var(--color-text-muted);
    font-size: 0.75rem;
    line-height: 1.5;
  }

  .newsletter__feedback {
    padding: 1.25rem;
    border-radius: var(--card-radius);
    margin-block: 0.5rem;
    width: 100%;
  }

  .newsletter__feedback--success {
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    color: var(--color-primary);
  }

  .newsletter__feedback--error {
    color: #d32f2f;
    text-align: left;
    margin-top: 0.5rem;
    padding: 0;
  }

  @media (max-width: 600px) {
    .newsletter__input-group {
      flex-direction: column;
      gap: 0.75rem;
    }
    .newsletter__submit {
      width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "THE EDIT"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "JOIN THE EDIT"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Be the first to discover new arrivals, exclusive offers and seasonal edits."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "SUBSCRIBE"
    },
    {
      "type": "text",
      "id": "privacy_note",
      "label": "Privacy notice text",
      "default": "By subscribing, you agree to our Privacy Policy and consent to receive marketing updates."
    },
    {
      "type": "select",
      "id": "bg_color",
      "label": "Background color",
      "options": [
        { "value": "warm_ivory", "label": "Warm Ivory" },
        { "value": "soft_beige", "label": "Soft Beige" },
        { "value": "dark", "label": "Charcoal Black" }
      ],
      "default": "soft_beige"
    },
    {
      "type": "select",
      "id": "section_spacing",
      "label": "Section spacing",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "medium"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width section",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
