{% comment %}
  Wakhan Styles - Trust & Service Benefits Section
  Minimal, editorial service badges with configurable icons, links, and borders.
{% endcomment %}

{%- liquid
  assign bg_class = 'bg-warm-ivory'
  if section.settings.bg_color == 'soft_beige'
    assign bg_class = 'bg-soft-beige'
  elsif section.settings.bg_color == 'white'
    assign bg_class = 'bg-white'
  endif
-%}

<section
  id="TrustBadges-{{ section.id }}"
  class="trust-badges {{ bg_class }} section-spacing--{{ section.settings.section_spacing | default: 'small' }}{% if section.settings.show_border_top %} has-border-top{% endif %}{% if section.settings.show_border_bottom %} has-border-bottom{% endif %}"
  role="region"
  aria-label="{{ section.settings.heading | default: 'Store Benefits & Guarantees' | escape }}"
>
  <div class="page-container">
    {%- if section.settings.heading != blank -%}
      <div class="trust-badges__header">
        <h2 class="text-eyebrow">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    <div class="trust-badges__grid" role="list">
      {%- for block in section.blocks -%}
        <div class="trust-badge-item" role="listitem" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" class="trust-badge-item__link">
          {%- else -%}
            <div class="trust-badge-item__content">
          {%- endif -%}

            {%- if block.settings.icon != 'none' -%}
              <div class="trust-badge-item__icon-wrapper" aria-hidden="true">
                {% render 'icon', name: block.settings.icon, class: 'trust-badge-item__icon' %}
              </div>
            {%- endif -%}

            <div class="trust-badge-item__text">
              <h3 class="trust-badge-item__title text-nav">
                {{ block.settings.title }}
              </h3>
              {%- if block.settings.description != blank -%}
                <p class="trust-badge-item__desc text-small">
                  {{ block.settings.description }}
                </p>
              {%- endif -%}
            </div>

          {%- if block.settings.link != blank -%}
            </a>
          {%- else -%}
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .trust-badges {
    width: 100%;
    position: relative;
  }

  .trust-badges.has-border-top {
    border-top: 1px solid var(--color-border);
  }

  .trust-badges.has-border-bottom {
    border-bottom: 1px solid var(--color-border);
  }

  .trust-badges__header {
    text-align: center;
    margin-bottom: 1.5rem;
  }

  .trust-badges__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: clamp(1.5rem, 3vw, 2.5rem);
    align-items: center;
  }

  .trust-badge-item {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .trust-badge-item__link,
  .trust-badge-item__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.625rem;
    text-decoration: none;
    color: var(--color-text);
    padding: 0.5rem;
    width: 100%;
    transition: transform var(--transition-fast);
  }

  .trust-badge-item__link:hover {
    transform: translateY(-2px);
  }

  .trust-badge-item__icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-primary);
  }

  .trust-badge-item__icon {
    width: 24px;
    height: 24px;
    stroke-width: 1.35;
  }

  .trust-badge-item__title {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0;
    line-height: 1.25;
  }

  .trust-badge-item__desc {
    color: var(--color-text-muted);
    font-size: 0.8125rem;
    margin: 0.25rem 0 0 0;
    line-height: 1.4;
  }

  @media (max-width: 768px) {
    .trust-badges__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.5rem 1rem;
    }
  }

  @media (max-width: 480px) {
    .trust-badge-item__title {
      font-size: 0.75rem;
    }
    .trust-badge-item__desc {
      font-size: 0.75rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Trust & Service Badges",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (optional)"
    },
    {
      "type": "select",
      "id": "bg_color",
      "label": "Background color",
      "options": [
        { "value": "warm_ivory", "label": "Warm Ivory" },
        { "value": "soft_beige", "label": "Soft Beige" },
        { "value": "white", "label": "Pure White" }
      ],
      "default": "warm_ivory"
    },
    {
      "type": "select",
      "id": "section_spacing",
      "label": "Section spacing",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "small"
    },
    {
      "type": "checkbox",
      "id": "show_border_top",
      "label": "Show top border",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_border_bottom",
      "label": "Show bottom border",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Service Benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "delivery", "label": "Delivery / Truck" },
            { "value": "returns", "label": "Returns / Exchange" },
            { "value": "secure", "label": "Secure Checkout / Shield" },
            { "value": "support", "label": "Customer Support" },
            { "value": "none", "label": "No icon" }
          ],
          "default": "delivery"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "SHIPPING & DELIVERY"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Complimentary on eligible orders"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust & Service Badges",
      "blocks": [
        {
          "type": "badge",
          "settings": {
            "icon": "delivery",
            "title": "SHIPPING & DELIVERY",
            "description": "Complimentary on eligible orders"
          }
        },
        {
          "type": "badge",
          "settings": {
            "icon": "returns",
            "title": "EASY RETURNS",
            "description": "Straightforward return policy"
          }
        },
        {
          "type": "badge",
          "settings": {
            "icon": "secure",
            "title": "SECURE CHECKOUT",
            "description": "Safe & encrypted payments"
          }
        },
        {
          "type": "badge",
          "settings": {
            "icon": "support",
            "title": "CUSTOMER SUPPORT",
            "description": "Dedicated assistance team"
          }
        }
      ]
    }
  ]
}
{% endschema %}
