{% comment %}
  Wakhan Styles - Editorial OS 2.0 Header
  Includes desktop mega-menu navigation, mobile drawer, predictive search trigger, and sticky header.
{% endcomment %}

{%- assign main_menu = linklists[section.settings.menu] | default: linklists['main-menu'] -%}

{%- assign has_nested_links = false -%}
{%- if main_menu != blank and main_menu.links.size > 0 -%}
  {%- for link in main_menu.links -%}
    {%- if link.links.size > 0 -%}
      {%- assign has_nested_links = true -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{%- if section.settings.use_editorial_sample_nav and has_nested_links == false -%}
  {%- assign render_editorial_nav = true -%}
{%- else -%}
  {%- assign render_editorial_nav = false -%}
{%- endif -%}

<header
  class="site-header full-width{% if section.settings.enable_sticky_header %} site-header--sticky{% endif %}{% if section.settings.show_separator_line %} site-header--bordered{% endif %} header-padding--{{ section.settings.header_padding | default: 'medium' }}"
  data-sticky-header="{{ section.settings.enable_sticky_header }}"
  role="banner"
  style="
    --logo-width-desktop: {{ section.settings.logo_width | default: 140 }}px;
    --logo-offset-x-desktop: {{ section.settings.logo_offset_x | default: 0 }}px;
    --logo-offset-y-desktop: {{ section.settings.logo_offset_y | default: 0 }}px;
    --logo-width-mobile: {{ section.settings.logo_width_mobile | default: section.settings.logo_width | default: 80 }}px;
    --logo-offset-x-mobile: {{ section.settings.logo_offset_x_mobile | default: 0 }}px;
    --logo-offset-y-mobile: {{ section.settings.logo_offset_y_mobile | default: 0 }}px;
  "
>
  <div class="site-header__container full-width">
    <!-- Left Column: Mobile Menu Toggle & Desktop Logo -->
    <div class="site-header__col site-header__col--left">
      <button
        type="button"
        class="site-header__mobile-toggle"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="MobileMenuDrawer"
        data-drawer-open
      >
        {% render 'icon', name: 'menu', class: 'icon-menu' %}
        <span class="visually-hidden">Open Menu</span>
      </button>

      <div class="site-header__logo-wrapper site-header__logo-wrapper--desktop">
        <a href="{{ routes.root_url }}" class="site-header__logo-link">
          {%- if section.settings.logo != blank -%}
            {%- assign logo_alt = section.settings.logo.alt | default: settings.brand_name | default: shop.name | escape -%}
            {{
              section.settings.logo
              | image_url: width: 600
              | image_tag:
                class: 'site-header__logo-img',
                widths: '120, 160, 200, 260, 320, 400',
                alt: logo_alt
            }}
          {%- else -%}
            <span class="site-header__logo-text font-heading">{{ settings.brand_name | default: shop.name }}</span>
          {%- endif -%}
        </a>
      </div>
    </div>

    <!-- Center Column: Desktop Navigation & Genuinely Centered Mobile Logo -->
    <div class="site-header__col site-header__col--center">
      <nav class="site-header__nav" role="navigation" aria-label="Main Navigation">
      <ul class="nav-list" role="list">
        {%- if render_editorial_nav -%}
          {% comment %}
            Editorial 7-Department Fashion Navigation & Mega Menus
          {% endcomment %}

          <!-- 1. MEN -->
          <li class="nav-item nav-item--has-mega" data-nav-item>
            <a href="{{ routes.collections_url }}/men" class="nav-link text-nav" aria-expanded="false">
              <span>MEN</span>
              {% render 'icon', name: 'chevron-down', class: 'nav-link__chevron' %}
            </a>
            <div class="mega-menu" role="region" aria-label="Men Collection Menu">
              <div class="mega-menu__container">
                <div class="mega-menu__column">
                  <h3 class="mega-menu__title text-eyebrow">Clothing</h3>
                  <ul class="mega-menu__list" role="list">
                    <li><a href="{{ routes.collections_url }}/men-jeans" class="mega-menu__link">Jeans</a></li>
                    <li><a href="{{ routes.collections_url }}/men-shirts" class="mega-menu__link">Shirts</a></li>
                    <li><a href="{{ routes.collections_url }}/men-sweaters" class="mega-menu__link">Sweaters</a></li>
                    <li><a href="{{ routes.collections_url }}/men-hoodies" class="mega-menu__link">Hoodies</a></li>
                    <li><a href="{{ routes.collections_url }}/men-coats-jackets" class="mega-menu__link">Coats & Jackets</a></li>
                  </ul>
                </div>
                <div class="mega-menu__column">
                  <h3 class="mega-menu__title text-eyebrow">Footwear & More</h3>
                  <ul class="mega-menu__list" role="list">
                    <li><a href="{{ routes.collections_url }}/footwear-men" class="mega-menu__link">Men's Shoes & Boots</a></li>
                    <li><a href="{{ routes.collections_url }}/men-accessories" class="mega-menu__link">Belts & Wallets</a></li>
                    <li><a href="{{ routes.collections_url }}/men-new" class="mega-menu__link mega-menu__link--accent">New In Men</a></li>
                  </ul>
                </div>
                <div class="mega-menu__column mega-menu__column--editorial">
                  <div class="mega-menu__card">
                    <span class="text-eyebrow">Editorial Pick</span>
                    <h4 class="mega-menu__card-title">Tailored Autumn Outerwear</h4>
                    <p class="mega-menu__card-desc">Structured wool-blend overcoats designed for contemporary city life.</p>
                    <a href="{{ routes.collections_url }}/men-coats-jackets" class="btn btn--small btn--primary">Explore Coats</a>
                  </div>
                </div>
              </div>
            </div>
          </li>

          <!-- 2. WOMEN -->
          <li class="nav-item nav-item--has-mega" data-nav-item>
            <a href="{{ routes.collections_url }}/women" class="nav-link text-nav" aria-expanded="false">
              <span>WOMEN</span>
              {% render 'icon', name: 'chevron-down', class: 'nav-link__chevron' %}
            </a>
            <div class="mega-menu" role="region" aria-label="Women Collection Menu">
              <div class="mega-menu__container">
                <div class="mega-menu__column">
                  <h3 class="mega-menu__title text-eyebrow">Clothing</h3>
                  <ul class="mega-menu__list" role="list">
                    <li><a href="{{ routes.collections_url }}/women-dresses" class="mega-menu__link">Dresses</a></li>
                    <li><a href="{{ routes.collections_url }}/women-suits-tailoring" class="mega-menu__link">Suits & Tailoring</a></li>
                    <li><a href="{{ routes.collections_url }}/women-sweaters" class="mega-menu__link">Sweaters</a></li>
                    <li><a href="{{ routes.collections_url }}/women-jeans" class="mega-menu__link">Jeans</a></li>
                    <li><a href="{{ routes.collections_url }}/women-coats-jackets" class="mega-menu__link">Coats & Jackets</a></li>
                    <li><a href="{{ routes.collections_url }}/women-sleepwear" class="mega-menu__link">Sleepwear</a></li>
                  </ul>
                </div>
                <div class="mega-menu__column">
                  <h3 class="mega-menu__title text-eyebrow">Curations</h3>
                  <ul class="mega-menu__list" role="list">
                    <li><a href="{{ routes.collections_url }}/footwear-women" class="mega-menu__link">Women's Footwear</a></li>
                    <li><a href="{{ routes.collections_url }}/jewellery" class="mega-menu__link">Fine Jewelry</a></li>
                    <li><a href="{{ routes.collections_url }}/women-new" class="mega-menu__link mega-menu__link--accent">New In Women</a></li>
                  </ul>
                </div>
                <div class="mega-menu__column mega-menu__column--editorial">
                  <div class="mega-menu__card">
                    <span class="text-eyebrow">Lookbook</span>
                    <h4 class="mega-menu__card-title">Architectural Silhouettes</h4>
                    <p class="mega-menu__card-desc">Understated luxury cut from premium European mills.</p>
                    <a href="{{ routes.collections_url }}/women-dresses" class="btn btn--small btn--primary">View Lookbook</a>
                  </div>
                </div>
              </div>
            </div>
          </li>

          <!-- 3. KIDS -->
          <li class="nav-item nav-item--has-mega" data-nav-item>
            <a href="{{ routes.collections_url }}/kids" class="nav-link text-nav" aria-expanded="false">
              <span>KIDS</span>
              {% render 'icon', name: 'chevron-down', class: 'nav-link__chevron' %}
            </a>
            <div class="mega-menu" role="region" aria-label="Kids Collection Menu">
              <div class="mega-menu__container">
                <div class="mega-menu__column">
                  <h3 class="mega-menu__title text-eyebrow">Categories</h3>
                  <ul class="mega-menu__list" role="list">
                    <li><a href="{{ routes.collections_url }}/kids-dresses" class="mega-menu__link">Dresses</a></li>
                    <li><a href="{{ routes.collections_url }}/kids-jeans" class="mega-menu__link">Jeans</a></li>
                    <li><a href="{{ routes.collections_url }}/kids-shirts" class="mega-menu__link">Shirts</a></li>
                    <li><a href="{{ routes.collections_url }}/kids-sweaters" class="mega-menu__link">Sweaters</a></li>
                    <li><a href="{{ routes.collections_url }}/kids-coats-jackets" class="mega-menu__link">Coats & Jackets</a></li>
                  </ul>
                </div>
                <div class="mega-menu__column">
                  <h3 class="mega-menu__title text-eyebrow">Essentials</h3>
                  <ul class="mega-menu__list" role="list">
                    <li><a href="{{ routes.collections_url }}/footwear-kids" class="mega-menu__link">Kids' Footwear</a></li>
                    <li><a href="{{ routes.collections_url }}/kids-new" class="mega-menu__link mega-menu__link--accent">New Arrivals</a></li>
                  </ul>
                </div>
              </div>
            </div>
          </li>

          <!-- 4. FOOTWEAR -->
          <li class="nav-item nav-item--has-mega" data-nav-item>
            <a href="{{ routes.collections_url }}/footwear" class="nav-link text-nav" aria-expanded="false">
              <span>FOOTWEAR</span>
              {% render 'icon', name: 'chevron-down', class: 'nav-link__chevron' %}
            </a>
            <div class="mega-menu" role="region" aria-label="Footwear Menu">
              <div class="mega-menu__container">
                <div class="mega-menu__column">
                  <h3 class="mega-menu__title text-eyebrow">Departments</h3>
                  <ul class="mega-menu__list" role="list">
                    <li><a href="{{ routes.collections_url }}/footwear-men" class="mega-menu__link">Men's Shoes & Boots</a></li>
                    <li><a href="{{ routes.collections_url }}/footwear-women" class="mega-menu__link">Women's Heels, Loafers & Boots</a></li>
                    <li><a href="{{ routes.collections_url }}/footwear-kids" class="mega-menu__link">Kids' Shoes & Sneakers</a></li>
                  </ul>
                </div>
                <div class="mega-menu__column">
                  <h3 class="mega-menu__title text-eyebrow">Highlights</h3>
                  <ul class="mega-menu__list" role="list">
                    <li><a href="{{ routes.collections_url }}/footwear-leather" class="mega-menu__link">Crafted Leather</a></li>
                    <li><a href="{{ routes.collections_url }}/footwear-trainers" class="mega-menu__link">Minimalist Sneakers</a></li>
                  </ul>
                </div>
              </div>
            </div>
          </li>

          <!-- 5. ACCESSORIES -->
          <li class="nav-item nav-item--has-mega" data-nav-item>
            <a href="{{ routes.collections_url }}/accessories" class="nav-link text-nav" aria-expanded="false">
              <span>ACCESSORIES</span>
              {% render 'icon', name: 'chevron-down', class: 'nav-link__chevron' %}
            </a>
            <div class="mega-menu" role="region" aria-label="Accessories Menu">
              <div class="mega-menu__container">
                <div class="mega-menu__column">
                  <h3 class="mega-menu__title text-eyebrow">Category</h3>
                  <ul class="mega-menu__list" role="list">
                    <li><a href="{{ routes.collections_url }}/jewellery" class="mega-menu__link">Jewelry</a></li>
                    <li><a href="{{ routes.collections_url }}/bags" class="mega-menu__link">Bags</a></li>
                    <li><a href="{{ routes.collections_url }}/hats" class="mega-menu__link">Hats</a></li>
                    <li><a href="{{ routes.collections_url }}/hair-accessories" class="mega-menu__link">Hair Accessories</a></li>
                  </ul>
                </div>
              </div>
            </div>
          </li>

          <!-- 6. BEAUTY -->
          <li class="nav-item">
            <a href="{{ routes.collections_url }}/beauty" class="nav-link text-nav">
              <span>BEAUTY</span>
            </a>
          </li>

          <!-- 7. SPORTS -->
          <li class="nav-item nav-item--has-mega" data-nav-item>
            <a href="{{ routes.collections_url }}/sports" class="nav-link text-nav" aria-expanded="false">
              <span>SPORTS</span>
              {% render 'icon', name: 'chevron-down', class: 'nav-link__chevron' %}
            </a>
            <div class="mega-menu" role="region" aria-label="Sports Menu">
              <div class="mega-menu__container">
                <div class="mega-menu__column">
                  <h3 class="mega-menu__title text-eyebrow">Disciplines</h3>
                  <ul class="mega-menu__list" role="list">
                    <li><a href="{{ routes.collections_url }}/football" class="mega-menu__link">Football</a></li>
                    <li><a href="{{ routes.collections_url }}/boxing" class="mega-menu__link">Boxing</a></li>
                    <li><a href="{{ routes.collections_url }}/badminton" class="mega-menu__link">Badminton</a></li>
                    <li><a href="{{ routes.collections_url }}/swimming" class="mega-menu__link">Swimming</a></li>
                  </ul>
                </div>
                <div class="mega-menu__column">
                  <h3 class="mega-menu__title text-eyebrow">&nbsp;</h3>
                  <ul class="mega-menu__list" role="list">
                    <li><a href="{{ routes.collections_url }}/table-tennis" class="mega-menu__link">Table Tennis</a></li>
                    <li><a href="{{ routes.collections_url }}/tennis" class="mega-menu__link">Tennis</a></li>
                    <li><a href="{{ routes.collections_url }}/basketball" class="mega-menu__link">Basketball</a></li>
                    <li><a href="{{ routes.collections_url }}/baseball" class="mega-menu__link">Baseball</a></li>
                  </ul>
                </div>
              </div>
            </div>
          </li>

        {%- else -%}
          {% comment %}
            Native Shopify Linklist Menu with dynamic multi-tier mega dropdowns
          {% endcomment %}
          {%- for link in main_menu.links -%}
            <li class="nav-item{% if link.links.size > 0 %} nav-item--has-mega{% endif %}" data-nav-item>
              <a
                href="{{ link.url }}"
                class="nav-link text-nav"
                {% if link.links.size > 0 %}
                  aria-expanded="false"
                  aria-haspopup="true"
                {% endif %}
              >
                <span>{{ link.title }}</span>
                {%- if link.links.size > 0 -%}
                  {% render 'icon', name: 'chevron-down', class: 'nav-link__chevron' %}
                {%- endif -%}
              </a>

              {%- if link.links.size > 0 -%}
                <div class="mega-menu" role="region" aria-label="{{ link.title }} Menu">
                  <div class="mega-menu__container">
                    {%- for child in link.links -%}
                      <div class="mega-menu__column">
                        <a href="{{ child.url }}" class="mega-menu__title text-eyebrow">{{ child.title }}</a>
                        {%- if child.links.size > 0 -%}
                          <ul class="mega-menu__list" role="list">
                            {%- for grandchild in child.links -%}
                              <li>
                                <a href="{{ grandchild.url }}" class="mega-menu__link">
                                  {{ grandchild.title }}
                                </a>
                              </li>
                            {%- endfor -%}
                          </ul>
                        {%- endif -%}
                      </div>
                    {%- endfor -%}
                  </div>
                </div>
              {%- endif -%}
            </li>
          {%- endfor -%}
        {%- endif -%}
      </ul>
      </nav>

      <div class="site-header__logo-wrapper site-header__logo-wrapper--mobile">
        <a href="{{ routes.root_url }}" class="site-header__logo-link">
          {%- if section.settings.logo != blank -%}
            {%- assign logo_alt = section.settings.logo.alt | default: settings.brand_name | default: shop.name | escape -%}
            {{
              section.settings.logo
              | image_url: width: 400
              | image_tag:
                class: 'site-header__logo-img',
                widths: '120, 160, 200, 260, 320',
                alt: logo_alt
            }}
          {%- else -%}
            <span class="site-header__logo-text font-heading">{{ settings.brand_name | default: shop.name }}</span>
          {%- endif -%}
        </a>
      </div>
    </div>

    <!-- Right: Actions -->
    <div class="site-header__col site-header__col--right site-header__actions">
      <!-- Search Trigger -->
      <button
        type="button"
        class="site-header__action-btn site-header__search-toggle"
        aria-label="Search store"
        aria-expanded="false"
        aria-controls="HeaderSearchDropdown"
        data-search-toggle
      >
        {% render 'icon', name: 'search' %}
        <span class="visually-hidden">Search</span>
      </button>

      <!-- Account Link -->
      {%- if shop.customer_accounts_enabled -%}
        <a
          href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}"
          class="site-header__action-btn"
          aria-label="Customer Account"
        >
          {% render 'icon', name: 'account' %}
          <span class="visually-hidden">Account</span>
        </a>
      {%- endif -%}

      <!-- Cart Link -->
      <a
        href="{{ routes.cart_url }}"
        class="site-header__action-btn site-header__cart-btn"
        aria-label="Shopping Cart, {{ cart.item_count }} items"
      >
        {% render 'icon', name: 'cart' %}
        <span class="visually-hidden">Cart</span>
        <span
          class="site-header__cart-badge{% if cart.item_count == 0 %} is-empty{% endif %}"
          data-cart-count
        >
          {{ cart.item_count }}
        </span>
      </a>
    </div>
  </div>

  <!-- Expandable Header Search Dropdown Overlay -->
  <div
    id="HeaderSearchDropdown"
    class="header-search-bar"
    role="region"
    aria-label="Search Form"
    aria-hidden="true"
    hidden
  >
    <div class="header-search-bar__inner">
      <form action="{{ routes.search_url }}" method="get" role="search" class="header-search-bar__form">
        <input
          type="search"
          name="q"
          placeholder="Search collections, articles, products..."
          class="header-search-bar__input"
          aria-label="Search our store"
          autocomplete="off"
          data-search-input
        >
        <button
          type="button"
          class="header-search-bar__close"
          aria-label="Close search"
          data-search-close
        >
          {% render 'icon', name: 'close' %}
          <span class="visually-hidden">Close</span>
        </button>
      </form>
    </div>
  </div>
</header>

<!-- Mobile Navigation Drawer -->
{% render 'mobile-menu-drawer', menu: main_menu, has_nested_links: has_nested_links %}

{% stylesheet %}
  .site-header {
    grid-column: 1 / -1;
    background-color: var(--color-background);
    width: 100%;
    position: relative;
    z-index: 100;
    transition: box-shadow var(--transition-normal), background-color var(--transition-normal);
  }

  .site-header--bordered {
    border-bottom: 1px solid var(--color-border);
  }

  .site-header--sticky {
    position: sticky;
    top: 0;
  }

  .site-header.is-stuck {
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
  }

  /* Header Padding Variants */
  .header-padding--compact .site-header__container {
    height: 3.75rem;
  }
  .header-padding--medium .site-header__container {
    height: 4.5rem;
  }
  .header-padding--relaxed .site-header__container {
    height: 5.25rem;
  }

  .site-header__container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: var(--page-margin);
    width: 100%;
    position: relative;
  }

  .site-header__col--left {
    display: flex;
    align-items: center;
    flex: 0 0 auto;
  }

  .site-header__col--center {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 1 1 auto;
  }

  .site-header__col--right {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.5rem;
    flex: 0 0 auto;
  }

  .site-header__mobile-toggle {
    display: none;
    background: transparent;
    border: none;
    padding: 12px;
    min-height: 48px;
    min-width: 48px;
    color: var(--color-text);
    cursor: pointer;
    align-items: center;
    justify-content: center;
  }

  .site-header__logo-wrapper--desktop {
    display: flex;
    align-items: center;
  }

  .site-header__logo-wrapper--desktop .site-header__logo-link {
    display: inline-flex;
    align-items: center;
    transform: translate(var(--logo-offset-x-desktop, 0px), var(--logo-offset-y-desktop, 0px));
    transition: transform var(--transition-fast);
  }

  .site-header__logo-wrapper--desktop .site-header__logo-img {
    max-width: var(--logo-width-desktop, 140px);
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  .site-header__logo-wrapper--mobile {
    display: none;
  }

  .site-header__logo-link {
    text-decoration: none;
    color: var(--color-text);
    display: inline-flex;
    align-items: center;
  }

  .site-header__logo-text {
    font-size: clamp(1.25rem, 1.8vw, 1.6rem);
    letter-spacing: 0.04em;
    font-weight: 500;
    line-height: 1;
    text-transform: uppercase;
  }

  .site-header__logo-img {
    height: auto;
    object-fit: contain;
  }

  /* Center: Desktop Navigation */
  .site-header__nav {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 1 1 auto;
    height: 100%;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 1.8vw, 2.25rem);
    list-style: none;
    margin: 0;
    padding: 0;
    height: 100%;
  }

  .nav-item {
    display: flex;
    align-items: center;
    height: 100%;
    position: static; /* Allows full-width mega menu */
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--color-text);
    text-decoration: none;
    font-family: var(--font-primary--family);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    height: 100%;
    position: relative;
    transition: color var(--transition-fast);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: var(--color-primary);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform var(--transition-normal);
  }

  .nav-link:hover,
  .nav-item:hover .nav-link,
  .nav-link:focus-visible {
    color: var(--color-accent);
  }

  .nav-item:hover .nav-link::after,
  .nav-link[aria-expanded="true"]::after {
    transform: scaleX(1);
  }

  .nav-link__chevron {
    transition: transform var(--transition-fast);
    opacity: 0.65;
  }

  .nav-item:hover .nav-link__chevron,
  .nav-link[aria-expanded="true"] .nav-link__chevron {
    transform: rotate(180deg);
    opacity: 1;
  }

  /* Mega Menu Panel */
  .mega-menu {
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    background-color: var(--color-background);
    border-bottom: 1px solid var(--color-border);
