{% comment %}
  Wakhan Styles - Editorial Hero Banner & Slideshow
  Primary high-impact campaign hero with auto-rotating banners (5s, 10s, 15s),
  smooth fade/slide transitions, progress indicators, desktop/mobile focal imagery,
  flexible content positioning, customizable overlays, and dual CTAs.
{% endcomment %}

{%- liquid
  if section.blocks.size > 0
    assign slide_count = section.blocks.size
  else
    assign slide_count = 1
  endif

  assign interval_seconds = section.settings.autoplay_interval | default: 5
-%}

<section
  id="HeroBanner-{{ section.id }}"
  class="hero-banner{% if section.settings.full_width %} full-width{% endif %} hero-banner--height-{{ section.settings.section_height }} hero-banner--transition-{{ section.settings.transition_style | default: 'fade' }}"
  data-hero-slideshow
  data-autoplay="{{ section.settings.enable_autoplay }}"
  data-interval="{{ interval_seconds }}"
  data-pause-hover="{{ section.settings.pause_on_hover }}"
  data-slide-count="{{ slide_count }}"
  data-autoplay-running="false"
  role="region"
  aria-roledescription="carousel"
  aria-label="{{ section.settings.heading | default: 'Hero Banner' | escape }}"
>
  <div class="hero-banner__slides-wrapper">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        {%- liquid
          assign slide_overlay = block.settings.overlay_opacity | default: section.settings.overlay_opacity | default: 25 | divided_by: 100.0
          assign slide_text_color = block.settings.text_color | default: section.settings.text_color | default: '#FFFFFF'
          assign slide_content_pos = block.settings.content_position | default: section.settings.content_position | default: 'middle-center'
          assign slide_align = block.settings.text_alignment | default: section.settings.text_alignment | default: 'center'
          if forloop.first
            assign slide_loading = 'eager'
            assign slide_fetchpriority = 'high'
          else
            assign slide_loading = 'lazy'
            assign slide_fetchpriority = 'auto'
          endif
        -%}
        <div
          class="hero-banner__slide{% if forloop.first %} is-active{% endif %}"
          data-slide-index="{{ forloop.index0 }}"
          style="--hero-text-color: {{ slide_text_color }}; --hero-overlay: rgba(0, 0, 0, {{ slide_overlay }});"
          role="tabpanel"
          aria-roledescription="slide"
          aria-label="{{ forloop.index }} of {{ slide_count }}"
          {{ block.shopify_attributes }}
        >
          <!-- Background Media Container -->
          <div class="hero-banner__media">
            {%- if block.settings.image != blank -%}
              <picture>
                {%- if block.settings.image_mobile != blank -%}
                  <source
                    media="(max-width: 768px)"
                    srcset="{{ block.settings.image_mobile | image_url: width: 800 }}"
                  >
                {%- endif -%}

                {{
                  block.settings.image
                  | image_url: width: 3000
                  | image_tag:
                    class: 'hero-banner__image',
                    widths: '750, 1100, 1500, 1800, 2200, 3000',
                    sizes: '100vw',
                    loading: slide_loading,
                    fetchpriority: slide_fetchpriority,
                    alt: block.settings.image.alt | default: block.settings.heading | escape
                }}
              </picture>
            {%- elsif section.settings.image != blank and forloop.first -%}
              <picture>
                {%- if section.settings.image_mobile != blank -%}
                  <source
                    media="(max-width: 768px)"
                    srcset="{{ section.settings.image_mobile | image_url: width: 800 }}"
                  >
                {%- endif -%}

                {{
                  section.settings.image
                  | image_url: width: 3000
                  | image_tag:
                    class: 'hero-banner__image',
                    widths: '750, 1100, 1500, 1800, 2200, 3000',
                    sizes: '100vw',
                    loading: 'eager',
                    fetchpriority: 'high',
                    alt: section.settings.image.alt | default: block.settings.heading | escape
                }}
              </picture>
            {%- else -%}
              <div class="hero-banner__placeholder">
                <div class="hero-banner__placeholder-bg"></div>
              </div>
            {%- endif -%}

            <!-- Dark Overlay Layer for Text Contrast -->
            <div class="hero-banner__overlay"></div>
          </div>

          <!-- Content Layer -->
          <div class="hero-banner__container page-container position--{{ slide_content_pos }} align--{{ slide_align }}">
            <div class="hero-banner__box">
              {%- if block.settings.eyebrow != blank -%}
                <span class="hero-banner__eyebrow text-eyebrow">{{ block.settings.eyebrow }}</span>
              {%- endif -%}

              {%- if block.settings.heading != blank -%}
                <h2 class="hero-banner__heading text-display font-heading">
                  {{ block.settings.heading }}
                </h2>
              {%- endif -%}

              {%- if block.settings.description != blank -%}
                <p class="hero-banner__description text-lead">
                  {{ block.settings.description }}
                </p>
              {%- endif -%}

              {%- if block.settings.primary_button_text != blank or block.settings.secondary_button_text != blank -%}
                <div class="hero-banner__actions">
                  {%- if block.settings.primary_button_text != blank -%}
                    <a
                      href="{{ block.settings.primary_button_link | default: routes.all_products_collection_url }}"
                      class="btn btn--primary hero-banner__btn"
                    >
                      {{ block.settings.primary_button_text }}
                    </a>
                  {%- endif -%}

                  {%- if block.settings.secondary_button_text != blank -%}
                    <a
                      href="{{ block.settings.secondary_button_link | default: routes.all_products_collection_url }}"
                      class="btn btn--secondary hero-banner__btn hero-banner__btn--secondary"
                    >
                      {{ block.settings.secondary_button_text }}
                    </a>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          </div>
        </div>
      {%- endfor -%}
    {%- else -%}
      <!-- Single Fallback Banner using Section Settings -->
      {%- liquid
        assign slide_overlay = section.settings.overlay_opacity | default: 25 | divided_by: 100.0
        assign slide_text_color = section.settings.text_color | default: '#FFFFFF'
        assign slide_content_pos = section.settings.content_position | default: 'middle-center'
        assign slide_align = section.settings.text_alignment | default: 'center'
      -%}
      <div
        class="hero-banner__slide is-active"
        data-slide-index="0"
        style="--hero-text-color: {{ slide_text_color }}; --hero-overlay: rgba(0, 0, 0, {{ slide_overlay }});"
        role="tabpanel"
      >
        <div class="hero-banner__media">
          {%- if section.settings.image != blank -%}
            <picture>
              {%- if section.settings.image_mobile != blank -%}
                <source
                  media="(max-width: 768px)"
                  srcset="{{ section.settings.image_mobile | image_url: width: 800 }}"
                >
              {%- endif -%}

              {{
                section.settings.image
                | image_url: width: 3000
                | image_tag:
                  class: 'hero-banner__image',
                  widths: '750, 1100, 1500, 1800, 2200, 3000',
                  sizes: '100vw',
                  loading: 'eager',
                  fetchpriority: 'high',
                  alt: section.settings.image.alt | default: section.settings.heading | escape
              }}
            </picture>
          {%- else -%}
            <div class="hero-banner__placeholder">
              <div class="hero-banner__placeholder-bg"></div>
            </div>
          {%- endif -%}

          <div class="hero-banner__overlay"></div>
        </div>

        <div class="hero-banner__container page-container position--{{ slide_content_pos }} align--{{ slide_align }}">
          <div class="hero-banner__box">
            {%- if section.settings.eyebrow != blank -%}
              <span class="hero-banner__eyebrow text-eyebrow">{{ section.settings.eyebrow }}</span>
            {%- endif -%}

            {%- if section.settings.heading != blank -%}
              <h1 class="hero-banner__heading text-display font-heading">
                {{ section.settings.heading }}
              </h1>
            {%- endif -%}

            {%- if section.settings.description != blank -%}
              <p class="hero-banner__description text-lead">
                {{ section.settings.description }}
              </p>
            {%- endif -%}

            {%- if section.settings.primary_button_text != blank or section.settings.secondary_button_text != blank -%}
              <div class="hero-banner__actions">
                {%- if section.settings.primary_button_text != blank -%}
                  <a
                    href="{{ section.settings.primary_button_link | default: routes.all_products_collection_url }}"
                    class="btn btn--primary hero-banner__btn"
                  >
                    {{ section.settings.primary_button_text }}
                  </a>
                {%- endif -%}

                {%- if section.settings.secondary_button_text != blank -%}
                  <a
                    href="{{ section.settings.secondary_button_link | default: routes.all_products_collection_url }}"
                    class="btn btn--secondary hero-banner__btn hero-banner__btn--secondary"
                  >
                    {{ section.settings.secondary_button_text }}
                  </a>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endif -%}
  </div>

  {%- if slide_count > 1 -%}
    {%- if section.settings.show_arrows -%}
      <div class="hero-banner__controls" aria-label="Carousel navigation">
        <button
          type="button"
          class="hero-banner__control hero-banner__control--prev"
          aria-label="Previous slide"
          data-slide-prev
        >
          {% render 'icon', name: 'chevron-left' %}
        </button>
        <button
          type="button"
          class="hero-banner__control hero-banner__control--next"
          aria-label="Next slide"
          data-slide-next
        >
          {% render 'icon', name: 'chevron-right' %}
        </button>
      </div>
    {%- endif -%}

    {%- if section.settings.show_dots -%}
      <div class="hero-banner__dots" role="tablist" aria-label="Slideshow pages">
        {%- for i in (1..slide_count) -%}
          <button
            type="button"
            class="hero-banner__dot{% if forloop.first %} is-active{% endif %}"
            role="tab"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            aria-label="Go to slide {{ i }}"
            data-slide-index="{{ forloop.index0 }}"
          >
            <span class="hero-banner__dot-progress" style="--interval-duration: {{ interval_seconds }}s;"></span>
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  {%- endif -%}
</section>

{% stylesheet %}
  .hero-banner {
    position: relative;
    width: 100%;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-primary);
  }

  /* Height Options */
  .hero-banner--height-small {
    min-height: 480px;
    height: 55vh;
  }
  .hero-banner--height-medium {
    min-height: 600px;
    height: 70vh;
  }
  .hero-banner--height-large {
    min-height: 720px;
    height: 85vh;
  }
  .hero-banner--height-full {
    min-height: 100vh;
    min-height: 100svh;
    height: 100vh;
    height: 100svh;
  }

  /* Slides Wrapper & Individual Slide */
  .hero-banner__slides-wrapper {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero-banner__slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 800ms cubic-bezier(0.25, 1, 0.5, 1), visibility 800ms;
  }

  .hero-banner__slide.is-active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    z-index: 2;
  }

  /* Slide Transition Mode */
  .hero-banner--transition-slide .hero-banner__slide {
    transform: translateX(100%);
    transition: transform 700ms cubic-bezier(0.16, 1, 0.3, 1), opacity 700ms, visibility 700ms;
  }

  .hero-banner--transition-slide .hero-banner__slide.is-active {
    transform: translateX(0);
    opacity: 1;
    visibility: visible;
  }

  .hero-banner--transition-slide .hero-banner__slide.is-prev {
    transform: translateX(-100%);
    opacity: 0;
    visibility: hidden;
  }

  /* Background Media */
  .hero-banner__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    overflow: hidden;
  }

  .hero-banner__media picture {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .hero-banner__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: center;
    display: block;
    transform: scale(1);
    transition: transform 0.6s ease-in;
  }

  /* Ken Burns Ambient Zoom Effect on Active Slide */
  .hero-banner__slide.is-active .hero-banner__image {
    transform: scale(1.035);
    transition: transform 8s ease-out;
  }

  /* Placeholder Styling when no image is uploaded */
  .hero-banner__placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #1f1f1f 0%, #111111 50%, #2a151b 100%);
  }

  .hero-banner__placeholder-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.15;
    background-image: radial-gradient(circle at 50% 50%, #ffffff 1px, transparent 1px);
    background-size: 24px 24px;
  }

  /* Overlay */
  .hero-banner__overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background: var(--hero-overlay);
    z-index: 2;
    pointer-events: none;
  }

  /* Content Positioning Grid */
  .hero-banner__container {
    position: relative;
    z-index: 3;
    width: 100%;
    height: 100%;
    display: flex;
    padding-block: var(--section-spacing-desktop);
  }

  .hero-banner__box {
    max-width: 760px;
    display: flex;
    flex-direction: column;
    color: var(--hero-text-color);
  }

  /* Vertical & Horizontal Positioning */
  .position--top-left {
    align-items: flex-start;
    justify-content: flex-start;
  }
  .position--top-center {
    align-items: flex-start;
    justify-content: center;
  }
  .position--top-right {
    align-items: flex-start;
    justify-content: flex-end;
  }

  .position--middle-left {
    align-items: center;
    justify-content: flex-start;
  }
  .position--middle-center {
    align-items: center;
    justify-content: center;
  }
  .position--middle-right {
    align-items: center;
    justify-content: flex-end;
  }

  .position--bottom-left {
    align-items: flex-end;
    justify-content: flex-start;
  }
  .position--bottom-center {
    align-items: flex-end;
    justify-content: center;
  }
  .position--bottom-right {
    align-items: flex-end;
    justify-content: flex-end;
  }

  /* Text Alignment */
  .align--left .hero-banner__box {
    text-align: left;
    align-items: flex-start;
  }
  .align--center .hero-banner__box {
    text-align: center;
    align-items: center;
    margin-inline: auto;
  }
  .align--right .hero-banner__box {
    text-align: right;
    align-items: flex-end;
    margin-left: auto;
  }

  /* Content Typography */
  .hero-banner__eyebrow {
    color: var(--hero-text-color);
    letter-spacing: 0.18em;
    opacity: 0.9;
    margin-bottom: 0.75rem;
  }

  .hero-banner__heading {
    color: var(--hero-text-color);
    line-height: 1.05;
    margin-bottom: 1.25rem;
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.25);
  }

  .hero-banner__description {
    color: var(--hero-text-color);
    opacity: 0.92;
    max-width: 58ch;
    margin-bottom: 2rem;
    font-size: clamp(1rem, 1.25vw, 1.2rem);
    line-height: 1.55;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.2);
  }

  /* Dual Action Buttons */
  .hero-banner__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
  }

  .align--center .hero-banner__actions {
    justify-content: center;
  }
  .align--right .hero-banner__actions {
    justify-content: flex-end;
  }

  .hero-banner__btn {
    min-width: 170px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
  }

  .hero-banner__btn--secondary {
    background-color: rgba(255, 255, 255, 0.12);
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(4px);
  }

  .hero-banner__btn--secondary:hover {
    background-color: #ffffff;
    border-color: #ffffff;
    color: #111111;
  }

  /* Staggered Content Animation on Slide Change */
  .hero-banner__slide.is-active .hero-banner__eyebrow {
    animation: heroFadeUp 600ms 120ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .hero-banner__slide.is-active .hero-banner__heading {
    animation: heroFadeUp 650ms 220ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .hero-banner__slide.is-active .hero-banner__description {
    animation: heroFadeUp 700ms 320ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .hero-banner__slide.is-active .hero-banner__actions {
    animation: heroFadeUp 750ms 420ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @keyframes heroFadeUp {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Carousel Navigation Arrows */
  .hero-banner__controls {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 5;
  }

  .hero-banner__control {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background-color: rgba(0, 0, 0, 0.28);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #ffffff;
    cursor: pointer;
    pointer-events: auto;
    transition: background-color var(--transition-fast), color var(--transition-fast), transform var(--transition-fast), border-color var(--transition-fast);
  }

  .hero-banner__control:hover {
    background-color: rgba(255, 255, 255, 0.92);
    color: #111111;
    border-color: #ffffff;
    transform: translateY(-50%) scale(1.08);
  }

  .hero-banner__control:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 2px;
  }

  .hero-banner__control--prev {
    left: 24px;
  }

  .hero-banner__control--next {
    right: 24px;
  }

  .hero-banner__control svg {
    width: 16px;
    height: 16px;
    display: block;
  }

  /* Carousel Dots & Progress Indicators */
  .hero-banner__dots {
    position: absolute;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 5;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .hero-banner__dot {
    position: relative;
    width: 36px;
    height: 16px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    padding: 0;
    cursor: pointer;
    transition: transform var(--transition-fast);
  }

  .hero-banner__dot::before {
    content: '';
    position: absolute;
    width: 100%;
    height: 3px;
    background: rgba(255, 255, 255, 0.35);
    border-radius: 2px;
    transition: background-color var(--transition-fast);
  }

  .hero-banner__dot:hover::before {
    background: rgba(255, 255, 255, 0.65);
  }

  .hero-banner__dot-progress {
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 0;
    height: 3px;
    background: #ffffff;
    border-radius: 2px;
    pointer-events: none;
  }

  /* Animated progress fill when active and running */
  .hero-banner[data-autoplay-running="true"] .hero-banner__dot.is-active .hero-banner__dot-progress {
    width: 100%;
    transition: width var(--interval-duration, 5s) linear;
  }

  .hero-banner[data-autoplay-running="false"] .hero-banner__dot.is-active .hero-banner__dot-progress {
    width: 100%;
    transition: none;
  }

  /* Mobile Responsive */
  @media (max-width: 768px) {
    .hero-banner--height-small {
      min-height: 420px;
      height: 55vh;
    }
    .hero-banner--height-medium {
      min-height: 520px;
      height: 70vh;
    }
    .hero-banner--height-large {
      min-height: 600px;
      height: 85vh;
    }
    .hero-banner--height-full {
      min-height: 100vh;
      min-height: 100svh;
      height: 100vh;
      height: 100svh;
    }

    .hero-banner__container {
      padding-block: var(--section-spacing-mobile);
      padding-inline: 1.25rem;
    }

    .hero-banner__heading {
      font-size: clamp(2rem, 7.5vw, 2.75rem);
      margin-bottom: 1rem;
    }

    .hero-banner__description {
      font-size: 0.95rem;
      margin-bottom: 1.75rem;
    }

    .hero-banner__actions {
      width: 100%;
      flex-direction: column;
      gap: 0.75rem;
    }

    .hero-banner__btn {
      width: 100%;
      min-height: 48px;
    }

    .hero-banner__control {
      width: 38px;
      height: 38px;
    }

    .hero-banner__control--prev {
      left: 12px;
    }

    .hero-banner__control--next {
      right: 12px;
    }

    .hero-banner__dots {
      bottom: 16px;
    }

    .hero-banner__dot {
      width: 28px;
    }
  }

  @media (max-width: 480px) {
    .hero-banner__box {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-banner__box > *,
    .hero-banner__slide,
    .hero-banner__image {
      animation: none !important;
      transition: none !important;
    }
  }
{% endstylesheet %}

<script>
  (function () {
    function initHeroSlideshow() {
      const sectionEl = document.getElementById('HeroBanner-{{ section.id }}');
      if (!sectionEl) return;

      const slides = Array.from(sectionEl.querySelectorAll('.hero-banner__slide'));
      const dots = Array.from(sectionEl.querySelectorAll('.hero-banner__dot'));
      const prevBtn = sectionEl.querySelector('[data-slide-prev]');
      const nextBtn = sectionEl.querySelector('[data-slide-next]');
      const slideCount = slides.length;

      if (slideCount <= 1) return;

      const enableAutoplay = sectionEl.dataset.autoplay === 'true';
      const intervalSec = parseFloat(sectionEl.dataset.interval) || 5;
      const intervalMs = intervalSec * 1000;
      const pauseOnHover = sectionEl.dataset.pauseHover === 'true';

      let currentIndex = 0;
      let timer = null;
      let isPaused = false;
      let touchStartX = 0;
      let touchEndX = 0;

      function updateSlides(newIndex, direction) {
        if (newIndex < 0) {
          newIndex = slideCount - 1;
        } else if (newIndex >= slideCount) {
          newIndex = 0;
        }

        slides.forEach((slide, idx) => {
          slide.classList.remove('is-active', 'is-prev');
          if (idx === currentIndex && direction === 'next') {
            slide.classList.add('is-prev');
          }
          if (idx === newIndex) {
            slide.classList.add('is-active');
            slide.setAttribute('aria-hidden', 'false');
          } else {
            slide.setAttribute('aria-hidden', 'true');
          }
        });

        dots.forEach((dot, idx) => {
          if (idx === newIndex) {
            dot.classList.add('is-active');
            dot.setAttribute('aria-selected', 'true');
          } else {
            dot.classList.remove('is-active');
            dot.setAttribute('aria-selected', 'false');
          }
        });

        currentIndex = newIndex;
        restartAutoplay();
      }

      function nextSlide() {
        updateSlides(currentIndex + 1, 'next');
      }

      function prevSlide() {
        updateSlides(currentIndex - 1, 'prev');
      }

      function startAutoplay() {
        if (!enableAutoplay || isPaused || slideCount <= 1) return;
        stopAutoplay();

        sectionEl.setAttribute('data-autoplay-running', 'false');
        // Trigger reflow to restart CSS progress animation
        const activeProgress = sectionEl.querySelector('.hero-banner__dot.is-active .hero-banner__dot-progress');
        if (activeProgress) {
          activeProgress.style.animation = 'none';
          void activeProgress.offsetWidth;
        }

        requestAnimationFrame(() => {
          sectionEl.setAttribute('data-autoplay-running', 'true');
        });

        timer = setTimeout(() => {
          nextSlide();
        }, intervalMs);
      }

      function stopAutoplay() {
        if (timer) {
          clearTimeout(timer);
          timer = null;
        }
        sectionEl.setAttribute('data-autoplay-running', 'false');
      }

      function restartAutoplay() {
        stopAutoplay();
        startAutoplay();
      }

      if (prevBtn) {
        prevBtn.addEventListener('click', (e) => {
          e.preventDefault();
          prevSlide();
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', (e) => {
          e.preventDefault();
          nextSlide();
        });
      }

      dots.forEach((dot) => {
        dot.addEventListener('click', (e) => {
          e.preventDefault();
          const targetIndex = parseInt(dot.dataset.slideIndex, 10);
          if (!isNaN(targetIndex) && targetIndex !== currentIndex) {
            updateSlides(targetIndex, targetIndex > currentIndex ? 'next' : 'prev');
          }
        });
      });

      // Pause on Hover
      if (pauseOnHover) {
        sectionEl.addEventListener('mouseenter', () => {
          isPaused = true;
          stopAutoplay();
        });

        sectionEl.addEventListener('mouseleave', () => {
          isPaused = false;
          startAutoplay();
        });
      }

      // Keyboard Navigation
      sectionEl.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') {
          prevSlide();
        } else if (e.key === 'ArrowRight') {
          nextSlide();
        }
      });

      // Touch Swipe Support
      sectionEl.addEventListener(
        'touchstart',
        (e) => {
          touchStartX = e.changedTouches[0].screenX;
        },
        { passive: true }
      );

      sectionEl.addEventListener(
        'touchend',
        (e) => {
          touchEndX = e.changedTouches[0].screenX;
          const diff = touchStartX - touchEndX;
          if (Math.abs(diff) > 40) {
            if (diff > 0) {
              nextSlide();
            } else {
              prevSlide();
            }
          }
        },
        { passive: true }
      );

      // Pause autoplay when banner is scrolled out of viewport
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                isPaused = false;
                startAutoplay();
              } else {
                isPaused = true;
                stopAutoplay();
              }
            });
          },
          { threshold: 0.25 }
        );
        observer.observe(sectionEl);
      } else {
        startAutoplay();
      }

      // Shopify Theme Editor Integration
      document.addEventListener('shopify:block:select', (e) => {
        if (e.target && e.target.classList.contains('hero-banner__slide')) {
          const idx = parseInt(e.target.dataset.slideIndex, 10);
          if (!isNaN(idx)) {
            stopAutoplay();
            updateSlides(idx);
          }
        }
      });

      document.addEventListener('shopify:block:deselect', () => {
        startAutoplay();
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHeroSlideshow);
    } else {
      initHeroSlideshow();
    }

    document.addEventListener('shopify:section:load', (e) => {
      if (e.detail && e.detail.sectionId === '{{ section.id }}') {
        initHeroSlideshow();
      }
    });
  })();
</script>

