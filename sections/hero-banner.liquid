{% comment %}
  Meticulous Fashion - Editorial Hero Banner
  Primary high-impact campaign hero with desktop/mobile focal imagery,
  flexible content positioning, customizable overlay, and dual CTAs.
{% endcomment %}

{%- liquid
  assign overlay_alpha = section.settings.overlay_opacity | divided_by: 100.0
  assign text_color = section.settings.text_color | default: '#FFFFFF'
-%}

<section
  id="HeroBanner-{{ section.id }}"
  class="hero-banner{% if section.settings.full_width %} full-width{% endif %} hero-banner--height-{{ section.settings.section_height }}"
  style="--hero-text-color: {{ text_color }}; --hero-overlay: rgba(0, 0, 0, {{ overlay_alpha }});"
  role="region"
  aria-label="{{ section.settings.heading | default: 'Hero Banner' | escape }}"
>
  <!-- Background Media Container -->
  <div class="hero-banner__media">
    {%- if section.settings.image != blank -%}
      <picture>
        {%- if section.settings.image_mobile != blank -%}
          <source
            media="(max-width: 768px)"
            srcset="{{ section.settings.image_mobile | image_url: width: 800 }}"
          >
        {%- endif -%}

        {{
          section.settings.image
          | image_url: width: 3000
          | image_tag:
            class: 'hero-banner__image',
            widths: '750, 1100, 1500, 1800, 2200, 3000',
            sizes: '100vw',
            loading: 'eager',
            fetchpriority: 'high',
            alt: section.settings.image.alt | default: section.settings.heading | escape
        }}
      </picture>
    {%- else -%}
      <!-- Editorial Lifestyle Placeholder for Dev/Theme Editor -->
      <div class="hero-banner__placeholder">
        <div class="hero-banner__placeholder-bg"></div>
      </div>
    {%- endif -%}

    <!-- Dark Overlay Layer for Text Contrast -->
    <div class="hero-banner__overlay"></div>
  </div>

  <!-- Content Layer -->
  <div class="hero-banner__container page-container position--{{ section.settings.content_position }} align--{{ section.settings.text_alignment }}">
    <div class="hero-banner__box">
      {%- if section.settings.eyebrow != blank -%}
        <span class="hero-banner__eyebrow text-eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 class="hero-banner__heading text-display font-heading">
          {{ section.settings.heading }}
        </h1>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <p class="hero-banner__description text-lead">
          {{ section.settings.description }}
        </p>
      {%- endif -%}

      {%- if section.settings.primary_button_text != blank or section.settings.secondary_button_text != blank -%}
        <div class="hero-banner__actions">
          {%- if section.settings.primary_button_text != blank -%}
            <a
              href="{{ section.settings.primary_button_link | default: routes.all_products_collection_url }}"
              class="btn btn--primary hero-banner__btn"
            >
              {{ section.settings.primary_button_text }}
            </a>
          {%- endif -%}

          {%- if section.settings.secondary_button_text != blank -%}
            <a
              href="{{ section.settings.secondary_button_link | default: routes.all_products_collection_url }}"
              class="btn btn--secondary hero-banner__btn hero-banner__btn--secondary"
            >
              {{ section.settings.secondary_button_text }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .hero-banner {
    position: relative;
    width: 100%;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Height Options */
  .hero-banner--height-small {
    min-height: 480px;
    height: 55vh;
  }
  .hero-banner--height-medium {
    min-height: 600px;
    height: 70vh;
  }
  .hero-banner--height-large {
    min-height: 720px;
    height: 85vh;
  }
  .hero-banner--height-full {
    min-height: 100svh;
  }

  /* Background Media */
  .hero-banner__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .hero-banner__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* Placeholder Styling when no image is uploaded */
  .hero-banner__placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #1f1f1f 0%, #111111 50%, #2a151b 100%);
    position: relative;
  }

  .hero-banner__placeholder-bg {
    width: 100%;
    height: 100%;
    opacity: 0.15;
    background-image: radial-gradient(circle at 50% 50%, #ffffff 1px, transparent 1px);
    background-size: 24px 24px;
  }

  /* Overlay */
  .hero-banner__overlay {
    position: absolute;
    inset: 0;
    background: var(--hero-overlay);
    z-index: 2;
    pointer-events: none;
  }

  /* Content Positioning Grid */
  .hero-banner__container {
    position: relative;
    z-index: 3;
    width: 100%;
    height: 100%;
    display: flex;
    padding-block: var(--section-spacing-desktop);
  }

  .hero-banner__box {
    max-width: 760px;
    display: flex;
    flex-direction: column;
    color: var(--hero-text-color);
  }

  /* Vertical & Horizontal Positioning */
  .position--top-left {
    align-items: flex-start;
    justify-content: flex-start;
  }
  .position--top-center {
    align-items: flex-start;
    justify-content: center;
  }
  .position--top-right {
    align-items: flex-start;
    justify-content: flex-end;
  }

  .position--middle-left {
    align-items: center;
    justify-content: flex-start;
  }
  .position--middle-center {
    align-items: center;
    justify-content: center;
  }
  .position--middle-right {
    align-items: center;
    justify-content: flex-end;
  }

  .position--bottom-left {
    align-items: flex-end;
    justify-content: flex-start;
  }
  .position--bottom-center {
    align-items: flex-end;
    justify-content: center;
  }
  .position--bottom-right {
    align-items: flex-end;
    justify-content: flex-end;
  }

  /* Text Alignment */
  .align--left .hero-banner__box {
    text-align: left;
    align-items: flex-start;
  }
  .align--center .hero-banner__box {
    text-align: center;
    align-items: center;
    margin-inline: auto;
  }
  .align--right .hero-banner__box {
    text-align: right;
    align-items: flex-end;
    margin-left: auto;
  }

  /* Content Typography */
  .hero-banner__eyebrow {
    color: var(--hero-text-color);
    letter-spacing: 0.18em;
    opacity: 0.9;
    margin-bottom: 0.75rem;
  }

  .hero-banner__heading {
    color: var(--hero-text-color);
    line-height: 1.05;
    margin-bottom: 1.25rem;
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.25);
  }

  .hero-banner__description {
    color: var(--hero-text-color);
    opacity: 0.92;
    max-width: 58ch;
    margin-bottom: 2rem;
    font-size: clamp(1rem, 1.25vw, 1.2rem);
    line-height: 1.55;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.2);
  }

  /* Dual Action Buttons */
  .hero-banner__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
  }

  .align--center .hero-banner__actions {
    justify-content: center;
  }
  .align--right .hero-banner__actions {
    justify-content: flex-end;
  }

  .hero-banner__btn {
    min-width: 170px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
  }

  .hero-banner__btn--secondary {
    background-color: rgba(255, 255, 255, 0.12);
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(4px);
  }

  .hero-banner__btn--secondary:hover {
    background-color: #ffffff;
    border-color: #ffffff;
    color: #111111;
  }

  /* Entrance Animation */
  .hero-banner__box > * {
    animation: heroFadeUp 700ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .hero-banner__eyebrow {
    animation-delay: 100ms;
  }
  .hero-banner__heading {
    animation-delay: 200ms;
  }
  .hero-banner__description {
    animation-delay: 300ms;
  }
  .hero-banner__actions {
    animation-delay: 400ms;
  }

  @keyframes heroFadeUp {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Mobile Responsive */
  @media (max-width: 768px) {
    .hero-banner--height-small {
      min-height: 420px;
      height: 50vh;
    }
    .hero-banner--height-medium {
      min-height: 520px;
      height: 65vh;
    }
    .hero-banner--height-large {
      min-height: 600px;
      height: 75vh;
    }

    .hero-banner__container {
      padding-block: var(--section-spacing-mobile);
      padding-inline: 1.25rem;
    }

    .hero-banner__heading {
      font-size: clamp(2rem, 7.5vw, 2.75rem);
      margin-bottom: 1rem;
    }

    .hero-banner__description {
      font-size: 0.95rem;
      margin-bottom: 1.75rem;
    }

    .hero-banner__actions {
      width: 100%;
      flex-direction: column;
      gap: 0.75rem;
    }

    .hero-banner__btn {
      width: 100%;
      min-height: 48px;
    }
  }

  @media (max-width: 480px) {
    .hero-banner__box {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-banner__box > * {
      animation: none !important;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Editorial Hero Banner",
  "settings": [
    {
      "type": "header",
      "content": "Imagery"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image (optional)"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "NEW SEASON"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "THE NEW STANDARD"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Contemporary pieces designed for everyday confidence."
    },
    {
      "type": "header",
      "content": "Primary Action"
    },
    {
      "type": "text",
      "id": "primary_button_text",
      "label": "Primary button text",
      "default": "SHOP MEN"
    },
    {
      "type": "url",
      "id": "primary_button_link",
      "label": "Primary button link"
    },
    {
      "type": "header",
      "content": "Secondary Action"
    },
    {
      "type": "text",
      "id": "secondary_button_text",
      "label": "Secondary button text",
      "default": "SHOP WOMEN"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Secondary button link"
    },
    {
      "type": "header",
      "content": "Layout & Style"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Content position",
      "options": [
        { "value": "top-left", "label": "Top left" },
        { "value": "top-center", "label": "Top center" },
        { "value": "top-right", "label": "Top right" },
        { "value": "middle-left", "label": "Middle left" },
        { "value": "middle-center", "label": "Middle center" },
        { "value": "middle-right", "label": "Middle right" },
        { "value": "bottom-left", "label": "Bottom left" },
        { "value": "bottom-center", "label": "Bottom center" },
        { "value": "bottom-right", "label": "Bottom right" }
      ],
      "default": "middle-center"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Overlay opacity",
      "default": 25
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "select",
      "id": "section_height",
      "label": "Section height",
      "options": [
        { "value": "small", "label": "Small (55vh)" },
        { "value": "medium", "label": "Medium (70vh)" },
        { "value": "large", "label": "Large (85vh)" },
        { "value": "full", "label": "Full screen (100vh)" }
      ],
      "default": "large"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width banner",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Editorial Hero Banner"
    }
  ]
}
{% endschema %}
